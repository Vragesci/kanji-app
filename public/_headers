# Header untuk Cloudflare Pages. Berkas ini disalin apa adanya ke akar dist/ saat build.
# Aturan yang cocok akan digabung, jadi blok /* di bawah tidak menimpa Cache-Control di atasnya.

# Service worker dan manifest tidak boleh di-cache lama; kalau tidak, pembaruan tidak sampai ke murid.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json

# Nama berkas di /assets/ memuat hash, jadi aman di-cache selamanya.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
