# Salin menjadi .env.local untuk pengembangan, dan isi juga di Cloudflare Pages
# (Settings -> Variables and Secrets) supaya ikut saat build produksi.
#
# Kunci anon memang boleh terlihat di kode klien yang sudah dibangun. Yang
# menjaga data murid adalah aturan keamanan baris (RLS) di Supabase, bukan
# kerahasiaan kunci ini. Jangan pernah memasang service_role key di sini:
# kunci itu melewati seluruh RLS.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
